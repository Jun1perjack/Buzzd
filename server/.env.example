PORT=3000
VERCEL_URL=https://buzzd.vercel.app

# Tunnel: install cloudflared for cross-network play (free, no account needed)
# https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# SteamOS: curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64 -o ~/cloudflared && chmod +x ~/cloudflared && sudo mv ~/cloudflared /usr/local/bin/cloudflared
# Without cloudflared, players must be on the same WiFi as the Deck.

# Optional: set a fixed room code instead of random each session
# ROOM_CODE=ABCD12

# ROM folder — server scans this for .iso/.bin/.chd etc. files.
# Player 1 (the host) picks a game from the list on their phone.
# ROMS_DIR=/home/deck/Games/PS2

# Only show ROMs whose filename contains this string (case-insensitive).
# Leave blank or remove to show all ROMs in the folder.
ROMS_FILTER=buzz

# SteamGridDB API key for cover art (free at steamgriddb.com).
# Without this, game picker shows letter placeholders instead of covers.
# STEAMGRIDDB_API_KEY=your_key_here

# PCSX2 launch command — base only, the selected ISO is appended automatically.
# SteamOS Flatpak:
# PCSX2_CMD=flatpak run net.pcsx2.PCSX2 --fullscreen
# AppImage:
# PCSX2_CMD=/home/deck/PCSX2.AppImage --fullscreen

# Virtual controller uses Python stdlib only (no pip/packages needed).
# Requires python3 (pre-installed on SteamOS) and /dev/uinput permissions.
# See README for the one-time udev rule setup.
# If uinput is unavailable the server still runs in fallback (log-only) mode.
