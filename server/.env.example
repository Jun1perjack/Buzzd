PORT=3000
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
VERCEL_URL=https://buzzd.vercel.app

# Optional: set a fixed room code instead of random each session
# ROOM_CODE=ABCD12

# Launch PCSX2 when the host clicks "Start Game".
# SteamOS Flatpak example:
# PCSX2_CMD=flatpak run net.pcsx2.PCSX2 --fullscreen "/home/deck/Games/buzz.iso"
# AppImage example:
# PCSX2_CMD=/home/deck/PCSX2.AppImage --fullscreen "/home/deck/Games/buzz.iso"

# Virtual controller uses Python stdlib only (no pip/packages needed).
# Requires python3 (pre-installed on SteamOS) and /dev/uinput permissions.
# See README for the one-time udev rule setup.
# If uinput is unavailable the server still runs in fallback (log-only) mode.
